---
import '../styles/global.css';
import { author } from '../data/author';

export interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonicalURL: string;
  currentLocale: string;
  altLangPath?: string;
}

const {
  title,
  description,
  ogImage = '/og/home.png',
  canonicalURL,
  currentLocale,
  altLangPath,
} = Astro.props;

const altLocale = currentLocale === 'es' ? 'en' : 'es';
const altPath = altLangPath ?? (currentLocale === 'es' ? '/en/' : '/');
const siteUrl = author.site;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: author.name,
  url: siteUrl,
  sameAs: [
    author.github,
    author.linkedin,
  ],
  jobTitle: author.role[currentLocale as 'es' | 'en'],
  description: author.tagline[currentLocale as 'es' | 'en'],
  knowsAbout: [
    'Java', 'PHP', 'Laravel', 'SQL', 'Docker', 'AWS', 'Linux',
    'WordPress', 'Python', 'Artificial Intelligence', 'API Architecture',
    'Backend Development', 'SEO',
  ],
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'El Cañaveral — Móstoles' },
    { '@type': 'CollegeOrUniversity', name: 'Senati — Lima, Perú' },
  ],
  worksFor: {
    '@type': 'Organization',
    name: 'e-SORT',
    url: 'https://www.e-sort.net',
  },
};
---

<!doctype html>
<html lang={currentLocale}>
  <head>
    <!-- Theme detection (blocking, before paint) -->
    <script is:inline>
      const theme = localStorage.getItem('theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      if (theme === 'dark' || (!theme && prefersDark)) {
        document.documentElement.classList.add('dark');
      }
    </script>

    <!-- Global Metadata -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/images/profile.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang={currentLocale === 'es' ? 'es-ES' : 'en-US'} href={canonicalURL} />
    <link rel="alternate" hreflang={altLocale === 'es' ? 'es-ES' : 'en-US'} href={siteUrl + altPath} />
    <link rel="alternate" hreflang="x-default" href={siteUrl + '/'} />

    <!-- Title & Description -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={siteUrl + ogImage} />
    <meta property="og:image:secure_url" content={siteUrl + ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="634" />
    <meta property="og:image:alt" content={title} />
    <meta name="author" content={author.name} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={siteUrl + ogImage} />
    <meta name="twitter:image:alt" content={title} />

    <!-- JSON-LD Structured Data -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>

    <!-- Sitemap -->
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>

  <body class="text-text bg-bg font-inter flex flex-col max-w-137.5 w-full px-4 md:px-0 mx-auto min-h-screen">
    <main class="grow">
      <slot />
    </main>

    <slot name="footer" />

    <!-- Lenis smooth scroll -->
    <script>
      import Lenis from 'lenis';

      const lenis = new Lenis({
        lerp: 0.06,
        smoothWheel: true,
      });

      function raf(time: number) {
        lenis.raf(time);
        requestAnimationFrame(raf);
      }
      requestAnimationFrame(raf);
    </script>

    <!-- Section entrance animation -->
    <script>
      (function run() {
        if (document.readyState === 'complete') return animate();
        window.addEventListener('load', animate);

        function animate() {
          const sections = document.querySelectorAll('section');
          sections.forEach((el, i) => {
            el.animate(
              {
                opacity: [0, 1],
                transform: ['translateY(40px)', 'translateY(0)'],
                filter: ['blur(20px)', 'blur(0)'],
              },
              {
                duration: 700,
                easing: 'ease-out',
                delay: i * 300,
                fill: 'forwards',
              }
            );
          });

          const aside = document.querySelector('aside');
          if (aside) {
            aside.animate(
              {
                opacity: [0, 1],
                transform: ['translateY(40px)', 'translateY(0)'],
                filter: ['blur(20px)', 'blur(0)'],
              },
              {
                duration: 700,
                easing: 'ease-out',
                delay: sections.length * 300,
                fill: 'forwards',
              }
            );
          }

          const footer = document.querySelector('footer');
          if (footer) {
            footer.animate(
              {
                opacity: [0, 1],
                transform: ['translateY(40px)', 'translateY(0)'],
                filter: ['blur(20px)', 'blur(0)'],
              },
              {
                duration: 700,
                easing: 'ease-out',
                delay: (sections.length + 1) * 300,
                fill: 'forwards',
              }
            );
          }
        }
      })();
    </script>

    <!-- Click ripple effect -->
    <script>
      addEventListener('click', (e) => {
        const target = e.target as Element;
        if (target.closest('a, button')) return;
        const div = document.createElement('div');
        div.style.cssText = `
          position: fixed;
          top: ${e.clientY}px;
          left: ${e.clientX}px;
          width: 6px;
          height: 6px;
          border-radius: 50%;
          background: var(--text);
          pointer-events: none;
          transform: translate(-50%, -50%);
          z-index: 9999;
        `;
        document.body.appendChild(div);
        div
          .animate(
            {
              transform: ['translate(-50%, -50%) scale(1)', 'translate(-50%, -50%) scale(2.5)'],
              opacity: [1, 0],
            },
            {
              duration: 250,
              easing: 'ease-out',
              fill: 'forwards',
            }
          )
          .finished.then(() => div.remove());
      });
    </script>
  </body>
</html>
