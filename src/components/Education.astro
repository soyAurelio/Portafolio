---
export interface EducationEntry {
  degree: string;
  school: string;
  date: string;
  note?: string;
}

export interface Props {
  title: string;
  entries: EducationEntry[];
}

const { title, entries } = Astro.props;
---

<section id="education" class="opacity-0 mt-14">
  <h2 class="text-text font-semibold text-[14px]">{title}</h2>

  <div class="mt-4 space-y-6">
    {entries.map((entry) => (
      <div>
        <div class="flex items-baseline justify-between flex-wrap gap-x-2">
          <h3 class="text-text font-medium text-[13px]">{entry.degree}</h3>
          <span class="text-gray font-normal text-[10px] whitespace-nowrap">{entry.date}</span>
        </div>
        <p class="text-gray font-normal text-[11px] mt-0.5">{entry.school}</p>
        {entry.note && (
          <p class="text-gray font-normal text-[11px] mt-0.5 italic">{entry.note}</p>
        )}
      </div>
    ))}
  </div>
</section>
