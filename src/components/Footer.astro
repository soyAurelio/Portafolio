---
import LanguageSwitcher from './LanguageSwitcher.astro';
import TypewriterName from './TypewriterName.astro';

export interface Props {
  themeLabel: string;
  themeTooltip: string;
  versionTooltip: string;
  lang: string;
  esPath?: string;
  enPath?: string;
}

const { themeLabel, themeTooltip, versionTooltip, lang, esPath = '/', enPath = '/en/' } = Astro.props;
const changelogPath = lang === 'es' ? '/changelog/' : '/en/changelog/';
---

<footer class="flex justify-between mt-10 pb-10 opacity-0 flex-wrap gap-y-3">
  <div class="flex flex-auto">
    <p class="text-text font-normal text-[12px]">
      &copy; 2026
      <TypewriterName
        scopeId="footer"
        staticPrefix="Marco "
        names={["Antonio", "Aurelio"]}
        startDelay={2200}
        typeSpeed={80}
        deleteSpeed={40}
        pauseShort={3200}
        pauseLong={4500}
      />
    </p>
  </div>
  <div class="flex items-center space-x-4">
    <LanguageSwitcher currentLang={lang as 'es' | 'en'} {esPath} {enPath} />

    <!-- Theme toggle -->
    <div class="flex items-center space-x-1">
      <p class="text-text font-normal text-[12px]">{themeLabel}</p>
      <button
        id="theme-toggle"
        class="text-[12px] leading-5 underline cursor-pointer select-none bg-transparent border-none p-0 text-inherit tooltip"
        aria-label="Cambiar tema"
        data-tooltip={themeTooltip}
      >
        light
      </button>
    </div>

    <!-- Version -->
    <a
      href={changelogPath}
      class="text-text text-[12px] hover:underline tooltip"
      data-tooltip={versionTooltip}>v1.0.0</a
    >
  </div>
</footer>

<script>
  const toggle = document.getElementById('theme-toggle');
  if (toggle) {
    const applyTheme = (theme: string) => {
      document.documentElement.classList.toggle('dark', theme === 'dark');
      toggle.textContent = theme;
    };

    let savedTheme = localStorage.getItem('theme');
    if (!savedTheme) {
      savedTheme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    }
    applyTheme(savedTheme);

    toggle.addEventListener('click', () => {
      const newTheme = toggle.textContent === 'dark' ? 'light' : 'dark';
      localStorage.setItem('theme', newTheme);
      applyTheme(newTheme);
    });

    document.addEventListener('astro:after-swap', () => {
      const theme = localStorage.getItem('theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const effectiveTheme = theme ?? (prefersDark ? 'dark' : 'light');
      document.documentElement.classList.toggle('dark', effectiveTheme === 'dark');
    });
  }
</script>
