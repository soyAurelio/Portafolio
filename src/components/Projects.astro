---
export interface Project {
  name: string;
  description: string;
  tags: string[];
  url: string;
}

export interface Props {
  title: string;
  description: string;
  projects: Project[];
}

const { title, description, projects } = Astro.props;
---

<section id="projects" class="opacity-0 mt-11">
  <a href="/projects" class="group inline-flex items-center space-x-1 hover:text-text">
    <h2 class="text-text font-semibold text-[14px]">
      {title}
    </h2>
    <svg
      class="text-gray group-hover:text-text"
      width="16"
      height="16"
      viewBox="0 0 16 16"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <line x1="4.5" y1="11.5" x2="11.5" y2="4.5"></line>
      <polyline points="4.5 4.5 11.5 4.5 11.5 11.5"></polyline>
    </svg>
  </a>
  <p class="text-gray font-normal text-[12px]">
    {description}
  </p>
  <ul class="grid grid-cols-2 gap-4 mt-4">
    {projects.map((project) => (
      <li class="border-border border rounded-md p-6 w-full hover:scale-[0.98] transform-gpu antialiased">
        <a href={project.url}>
          <div class="flex items-center justify-between space-x-1">
            <h4 class="text-text font-semibold text-[14px]">{project.name}</h4>
            <svg
              class="text-gray"
              width="16"
              height="16"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <line x1="4.5" y1="11.5" x2="11.5" y2="4.5"></line>
              <polyline points="4.5 4.5 11.5 4.5 11.5 11.5"></polyline>
            </svg>
          </div>
          <p class="text-gray font-normal text-[12px] mt-1">
            {project.description}
          </p>
          <div class="flex gap-2 mt-2 flex-wrap">
            {project.tags.map((tag) => (
              <span class="border border-border px-2 py-[2px] rounded-md text-[11px] text-gray">
                {tag}
              </span>
            ))}
          </div>
        </a>
      </li>
    ))}
  </ul>
</section>
