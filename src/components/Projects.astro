---
export interface Project {
  name: string;
  description: string;
  tags: string[];
  url: string;
  status?: 'completed' | 'in-progress' | 'planned';
  statusLabel?: string;
}

export interface Props {
  title: string;
  description: string;
  projects: Project[];
  allHref?: string;
  allText?: string;
}

const { title, description, projects, allHref, allText: _allText } = Astro.props;
---

<section id="projects" class="opacity-0 mt-10">
  <a href={allHref || '#'} class="group inline-flex items-center space-x-1 hover:text-text">
    <h2 class="text-text font-semibold text-[14px]">
      {title}
    </h2>
    <svg
      class="text-gray group-hover:text-text"
      width="16" height="16" viewBox="0 0 16 16"
      fill="none" stroke="currentColor" stroke-width="1.5"
      stroke-linecap="round" stroke-linejoin="round"
    >
      <line x1="4.5" y1="11.5" x2="11.5" y2="4.5"></line>
      <polyline points="4.5 4.5 11.5 4.5 11.5 11.5"></polyline>
    </svg>
  </a>
  <p class="text-gray font-normal text-[12px]">
    {description}
  </p>

  <ul class="project-grid grid grid-cols-1 sm:grid-cols-2 gap-4 mt-4">
    {projects.map((project) => (
      <li
        class="project-card border-border border rounded-md p-6 w-full hover:scale-[0.98] transform-gpu antialiased"
      >
        <a href={project.url} class="flex flex-col h-full">
          <div class="flex items-center justify-between space-x-1 shrink-0">
            <div class="flex items-center gap-2 min-w-0">
              <h4 class="text-text font-semibold text-[14px] truncate">{project.name}</h4>
              {project.status && project.statusLabel && (
                <span class={`shrink-0 border px-1.5 py-px rounded-md text-[10px] leading-normal ${
                  project.status === 'completed' ? 'border-emerald-500/40 text-emerald-600 dark:text-emerald-400' :
                  project.status === 'in-progress' ? 'border-amber-500/40 text-amber-600 dark:text-amber-400' :
                  'border-gray-400/40 text-gray-500'
                }`}>
                  {project.statusLabel}
                </span>
              )}
            </div>
            <svg
              class="text-gray shrink-0"
              width="16" height="16" viewBox="0 0 16 16"
              fill="none" stroke="currentColor" stroke-width="1.5"
              stroke-linecap="round" stroke-linejoin="round"
            >
              <line x1="4.5" y1="11.5" x2="11.5" y2="4.5"></line>
              <polyline points="4.5 4.5 11.5 4.5 11.5 11.5"></polyline>
            </svg>
          </div>

          <!-- Description: single-line, marquee on hover -->
          <div class="project-desc-clamp overflow-hidden mt-1">
            <p class="project-desc-inner text-gray font-normal text-[12px] whitespace-nowrap">
              {project.description}
            </p>
          </div>

          <div class="project-tags-row flex gap-2 mt-auto pt-2 flex-nowrap overflow-hidden pb-0.5">
            <div class="flex gap-2 flex-nowrap">
              {project.tags.map((tag) => (
                <span class="border border-border px-2 py-0.5 rounded-md text-[11px] text-gray shrink-0">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        </a>
      </li>
    ))}
  </ul>
</section>

<script is:inline src="/scripts/project-marquee.js"></script>

<style>
  .project-card {
    min-height: 9.5rem;
  }

  .project-desc-clamp {
    overflow: hidden;
  }

  .project-desc-inner {
    will-change: transform;
  }

  /* Last odd item spans full width */
  .project-grid > :last-child:nth-child(odd) {
    grid-column: 1 / -1;
  }
</style>