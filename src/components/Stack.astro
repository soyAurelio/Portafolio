---
export interface Props {
  title: string;
  description: string;
  items: string[];
}

const { title, description, items } = Astro.props;
---

<section id="stack" class="opacity-0 mt-14">
  <div class="flex items-center space-x-1">
    <h2 class="text-text font-semibold text-[14px]">
      {title}
    </h2>
  </div>
  <p class="text-gray font-normal text-[12px]">
    {description}
  </p>
  <div class="flex flex-wrap gap-2 mt-4">
    {items.map((item) => (
      <span class="border border-border px-3 py-[2px] rounded-md text-[12px] text-text font-normal">
        {item}
      </span>
    ))}
  </div>
</section>
