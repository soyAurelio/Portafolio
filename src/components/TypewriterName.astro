---
export interface Props {
  scopeId: string;
  greeting?: string;
  staticPrefix?: string;
  names: string[];
  typeSpeed?: number;
  deleteSpeed?: number;
  pauseShort?: number;
  pauseLong?: number;
  startDelay?: number;
}

const {
  scopeId,
  greeting = '',
  staticPrefix = '',
  names,
  typeSpeed = 100,
  deleteSpeed = 50,
  pauseShort = 2200,
  pauseLong = 3500,
  startDelay = 1500,
} = Astro.props;

const gId = `tw-${scopeId}-greeting`;
const sId = `tw-${scopeId}-static`;
const dId = `tw-${scopeId}-dynamic`;
const cId = `tw-${scopeId}-cursor`;
---

<span data-tw-scope={scopeId} class="inline">
  {greeting && <span id={gId}>{greeting} </span>}
  {staticPrefix && <span id={sId} class="font-bold">{staticPrefix}</span>}
  <span id={dId} class="font-bold"></span>
  <span id={cId} class="font-normal" aria-hidden="true">|</span>
</span>

<style>
  [id^="tw-"][id$="-cursor"] {
    animation: tw-blink 0.8s step-end infinite;
    color: var(--text);
  }

  @keyframes tw-blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }
</style>

<script is:inline define:vars={{ dId, names, typeSpeed, deleteSpeed, pauseShort, pauseLong, startDelay }}>
  (function() {
    const dynamic = document.getElementById(dId);
    if (!dynamic) return;

    let nameIndex = 0;
    let charIndex = 0;
    let isDeleting = false;

    function tick() {
      const currentName = names[nameIndex];

      if (!isDeleting) {
        dynamic.textContent = currentName.slice(0, charIndex + 1);
        charIndex++;

        if (charIndex === currentName.length) {
          const pause = nameIndex === names.length - 1 ? pauseLong : pauseShort;
          setTimeout(() => {
            isDeleting = true;
            tick();
          }, pause);
          return;
        }
      } else {
        dynamic.textContent = currentName.slice(0, charIndex - 1);
        charIndex--;

        if (charIndex === 0) {
          isDeleting = false;
          nameIndex = (nameIndex + 1) % names.length;
          setTimeout(tick, 200);
          return;
        }
      }

      const speed = isDeleting ? deleteSpeed : typeSpeed;
      const jitter = Math.random() * 40 - 20;
      setTimeout(tick, speed + jitter);
    }

    setTimeout(tick, startDelay);
  })();
</script>
