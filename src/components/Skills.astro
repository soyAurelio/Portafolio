---
export interface Props {
  title: string;
  description: string;
  items: string[];
}

const { title, description, items } = Astro.props;
---

<section id="skills" class="opacity-0 mt-14">
  <h2 class="text-text font-semibold text-[14px]">{title}</h2>
  <p class="text-gray font-normal text-[12px]">{description}</p>
  <div class="flex flex-wrap gap-2 mt-3">
    {items.map((item) => (
      <span class="text-text font-normal text-[12px]">
        {item}
        <!-- Only add comma if not last -->
      </span>
    ))}
  </div>
</section>
