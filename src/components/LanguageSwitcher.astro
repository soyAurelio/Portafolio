---
export interface Props {
  currentLang: 'es' | 'en';
  /** Path to the same page in the other language */
  esPath?: string;
  enPath?: string;
}

const { currentLang, esPath = '/', enPath = '/en/' } = Astro.props;
---

<span class="inline-flex items-center space-x-1">
  {currentLang === 'es' ? (
    <span class="text-text text-[12px]" aria-current="page">ES</span>
  ) : (
    <a href={esPath} hreflang="es-ES" class="text-gray hover:text-text text-[12px] tooltip" data-tooltip="Español">ES</a>
  )}
  <span class="text-gray text-[10px] select-none" aria-hidden="true">·</span>
  {currentLang === 'en' ? (
    <span class="text-text text-[12px]" aria-current="page">EN</span>
  ) : (
    <a href={enPath} hreflang="en-US" class="text-gray hover:text-text text-[12px] tooltip" data-tooltip="English">EN</a>
  )}
</span>
