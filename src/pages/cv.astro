---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import { useTranslations, getLangFromUrl, getAltPath } from '../i18n/utils';

const url = new URL(Astro.request.url);
const lang = getLangFromUrl(url);
const t = useTranslations(lang);

const altEsPath = getAltPath(url, lang, 'es');
const altEnPath = getAltPath(url, lang, 'en');

const title = lang === 'es' ? 'CV — Marco Aurelio' : 'Résumé — Marco Aurelio';
const canonicalURL = 'https://soyaurelio.dev/cv/';
---

<Layout
  title={title}
  description={t('cv.description')}
  canonicalURL={canonicalURL}
  currentLocale={lang}
  altLangPath={lang === 'es' ? altEnPath : altEsPath}
>
  <div class="pt-4 sm:pt-6">
    <section id="cv-viewer" class="opacity-0">
      <a href="/" class="group inline-flex items-center space-x-1 mb-4">
        <svg class="text-gray group-hover:text-text" width="16" height="16" viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="17" y1="17" x2="7" y2="7"></line>
          <polyline points="7 17 7 7 17 7"></polyline>
        </svg>
        <p class="text-gray group-hover:text-text text-end font-normal text-[12px]">{t('nav.home')}</p>
      </a>

      <div id="cv-toolbar" class="flex items-center justify-between mb-3 gap-3 flex-wrap">
        <span id="cv-title" class="text-text font-semibold text-[14px]">CV — Marco Antonio</span>
        <div class="flex items-center gap-3">
          <a href="/images/cv.pdf" download class="text-gray hover:text-text text-[12px] hover:underline">
            {t('cv.download')}
          </a>
          <div class="flex items-center gap-2">
            <button id="cv-prev" class="text-gray hover:text-text text-[20px] leading-none bg-transparent border-none p-0 cursor-pointer disabled:opacity-30" aria-label={t('cv.prev')}>&larr;</button>
            <span class="text-gray text-[11px] tabular-nums"><span id="cv-page-num">1</span> / <span id="cv-page-count">1</span></span>
            <button id="cv-next" class="text-gray hover:text-text text-[20px] leading-none bg-transparent border-none p-0 cursor-pointer disabled:opacity-30" aria-label={t('cv.next')}>&rarr;</button>
          </div>
        </div>
      </div>

      <div id="cv-canvas-wrapper" class="flex justify-center">
        <canvas id="cv-canvas" class="max-w-full border border-border rounded-md shadow-sm"></canvas>
      </div>
    </section>
  </div>

  <Footer slot="footer"
    themeLabel={t('footer.theme')}
    themeTooltip={t('footer.themeTooltip')}
    versionTooltip={t('footer.versionTooltip')}
    lang={lang}
    esPath={altEsPath}
    enPath={altEnPath}
  />
</Layout>

<script>
  import * as pdfjsLib from 'pdfjs-dist';
  pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdn.jsdelivr.net/npm/pdfjs-dist@4.10.38/build/pdf.worker.min.mjs';

  const cvUrl = '/images/cv.pdf';

  let pdfDoc: any = null;
  let pageNum = 1;
  let pageRendering = false;
  let pageNumPending: number | null = null;
  const scale = 1.5;

  const canvas = document.getElementById('cv-canvas') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;

  function renderPage(num: number) {
    pageRendering = true;
    pdfDoc.getPage(num).then((page: any) => {
      const viewport = page.getViewport({ scale });
      const outputScale = window.devicePixelRatio || 1;
      canvas.width = Math.floor(viewport.width * outputScale);
      canvas.height = Math.floor(viewport.height * outputScale);
      canvas.style.width = Math.floor(viewport.width) + 'px';
      canvas.style.height = Math.floor(viewport.height) + 'px';
      const transform = outputScale !== 1 ? [outputScale, 0, 0, outputScale, 0, 0] : null;
      const renderContext = { canvasContext: ctx, transform, viewport };
      const renderTask = page.render(renderContext);
      renderTask.promise.then(() => {
        pageRendering = false;
        if (pageNumPending !== null) {
          renderPage(pageNumPending);
          pageNumPending = null;
        }
      });
    });
    (document.getElementById('cv-page-num') as HTMLElement).textContent = String(num);
  }

  function queueRenderPage(num: number) {
    if (pageRendering) { pageNumPending = num; }
    else { renderPage(num); }
  }

  function updateButtons() {
    const prev = document.getElementById('cv-prev') as HTMLButtonElement;
    const next = document.getElementById('cv-next') as HTMLButtonElement;
    prev.disabled = pageNum <= 1;
    next.disabled = pageNum >= (pdfDoc?.numPages || 1);
  }

  const loadingTask = pdfjsLib.getDocument({ url: cvUrl });
  loadingTask.promise.then((pdf: any) => {
    pdfDoc = pdf;
    (document.getElementById('cv-page-count') as HTMLElement).textContent = String(pdf.numPages);
    renderPage(pageNum);
    updateButtons();

    document.getElementById('cv-prev')!.addEventListener('click', () => {
      if (pageNum <= 1) return;
      pageNum--;
      queueRenderPage(pageNum);
      updateButtons();
    });
    document.getElementById('cv-next')!.addEventListener('click', () => {
      if (pageNum >= pdfDoc.numPages) return;
      pageNum++;
      queueRenderPage(pageNum);
      updateButtons();
    });
  });
</script>
