---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import Experience from '../../components/Experience.astro';
import Projects from '../../components/Projects.astro';
import Stack from '../../components/Stack.astro';
import Footer from '../../components/Footer.astro';
import { useTranslations, getLangFromUrl, getAltPath } from '../../i18n/utils';
import { projects as projectData } from '../../data/projects';
import { stackItems } from '../../data/stack';
import { experiences as experienceData } from '../../data/experience';

const url = new URL(Astro.request.url);
const lang = getLangFromUrl(url);
const t = useTranslations(lang);

const altEsPath = getAltPath(url, lang, 'es');
const altEnPath = getAltPath(url, lang, 'en');

const experiences = experienceData.map(e => ({
  role: e.role.en,
  company: e.company.en,
  date: e.date.en,
  descriptions: e.descriptions.en,
}));

const projects = projectData.map(p => ({
  name: p.name.en,
  description: p.description.en,
  tags: p.tags,
  url: `/en/projects/${p.slug}/`,
  status: p.status,
  statusLabel: t(`projects.status.${p.status}`),
}));

const canonicalURL = 'https://soyaurelio.dev/en/';
---

<Layout
  title={t('site.title')}
  description={t('site.description')}
  canonicalURL={canonicalURL}
  currentLocale={lang}
  altLangPath={altEsPath}
>
  <Hero
    greeting={t('hero.greeting')}
    bioLine1={t('hero.bio.line1')}
    cvPreviewText={t('cv.preview')}
    cvDownloadText={t('cv.download')}
    cvCloseText={t('cv.close')}
    cvFormatText={t('cv.format')}
    lang={lang}
  />

  <Experience title={t('experience.title')} entries={experiences} />

  <Projects
    title={t('projects.title')}
    description={t('projects.description')}
    projects={projects}
    allHref="/en/projects/"
    allText={t('projects.all')}
  />

  <Stack
    title={t('stack.title')}
    description={t('stack.description')}
    items={stackItems}
  />

  <Footer slot="footer"
    themeLabel={t('footer.theme')}
    themeTooltip={t('footer.themeTooltip')}
    versionTooltip={t('footer.versionTooltip')}
    lang={lang}
    esPath={altEsPath}
    enPath={altEnPath}
  />
</Layout>
