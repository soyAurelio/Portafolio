---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import { changelog } from '../data/changelog';
import { useTranslations, getLangFromUrl, getAltPath } from '../i18n/utils';

const url = new URL(Astro.request.url);
const lang = getLangFromUrl(url);
const t = useTranslations(lang);

const altEsPath = getAltPath(url, lang, 'es');
const altEnPath = getAltPath(url, lang, 'en');

const title = 'Changelog — Marco Aurelio';
const canonicalURL = 'https://soyaurelio.dev/changelog/';
---

<Layout
  title={title}
  description={t('changelog.description')}
  canonicalURL={canonicalURL}
  currentLocale={lang}
  altLangPath={altEnPath}
>
  <div class="pt-20 sm:pt-28">
    <section id="changelog" class="opacity-0">
      <a href="/" class="group inline-flex items-center space-x-1">
        <svg
          class="text-gray group-hover:text-text"
          width="16" height="16" viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
        >
          <line x1="17" y1="17" x2="7" y2="7"></line>
          <polyline points="7 17 7 7 17 7"></polyline>
        </svg>
        <p class="text-gray group-hover:text-text text-end font-normal text-[12px]">
          {t('nav.home')}
        </p>
      </a>

      <h2 class="text-text font-semibold text-[14px] mt-8">
        {t('changelog.title')}
      </h2>
      <p class="text-gray font-normal text-[12px]">
        {t('changelog.description')}
      </p>

      <div class="text-text font-normal text-[12px] leading-[20px] mt-8">
        {changelog.map((entry) => (
          <div>
            <div class="mt-8 flex">
              <p class="text-[13px] font-semibold">{entry.version}</p>
              <p class="text-[11px] font-normal text-gray">&nbsp; — {entry.date}</p>
            </div>
            <ul class="text-gray mt-1 list-disc list-inside">
              {entry.changes.es.map((change) => (
                <li>{change}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <p class="flex justify-center text-gray font-normal text-[12px] mt-8">
        {t('changelog.thatsAll')}
      </p>
    </section>
  </div>

  <Footer slot="footer"
    themeLabel={t('footer.theme')}
    themeTooltip={t('footer.themeTooltip')}
    versionTooltip={t('footer.versionTooltip')}
    lang={lang}
    esPath={altEsPath}
    enPath={altEnPath}
  />
</Layout>
